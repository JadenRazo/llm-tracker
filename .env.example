# Postgres — shared-postgres container on the host.
# NOTE: the `claude_tracker` DB name is the existing physical database; it is
# not a brand string. Renaming it would be a separate data migration.
DATABASE_URL=postgresql://portfolio_admin:CHANGEME@host.docker.internal:5433/claude_tracker

# Optional: canonical public site origin (drives metadataBase / OpenGraph URL).
# Defaults to https://llm.raizhost.com when unset; override for preview deploys.
NEXT_PUBLIC_SITE_URL=https://llm.raizhost.com

# Optional: Anthropic API key, used ONLY server-side by the models poller (/v1/models).
# If unset, the models source is skipped with an info log.
ANTHROPIC_API_KEY=

# Optional: GitHub PAT (public_repo read-only is fine).
# If unset, GitHub releases still work unauthenticated at 60 req/hr.
GITHUB_TOKEN=

# Random hex, required by POST /api/admin/run-poller (localhost-only manual trigger).
ADMIN_TOKEN=

NODE_ENV=production
