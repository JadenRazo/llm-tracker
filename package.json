{
  "name": "llm-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3200",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file=.env node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env node_modules/.bin/drizzle-kit migrate",
    "db:push": "node --env-file=.env node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file=.env node_modules/.bin/drizzle-kit studio",
    "db:seed": "node --env-file=.env scripts/seed-cli-reference.mjs",
    "db:backfill-provider": "node --env-file=.env scripts/backfill-provider.mjs",
    "build:poller": "node scripts/build-poller.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "next": "^15.5.21",
    "next-mdx-remote": "^6.0.0",
    "node-cron": "^4.6.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "typescript": "^5.7.0",
    "esbuild": "^0.28.1"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.0",
    "esbuild": "^0.28.1"
  }
}
